# Settings shared by every repo. `looper init` writes this file and adds one
# [[repos]] entry per repository at the bottom; run it again to add another.
# An entry's `model` replaces [agent].model for that repo.

[agent]
claude_bin = "claude"
model = "sonnet"
max_turns = 60
max_budget_usd = 5.0          # ceiling for a single claude run
run_timeout_sec = 3600
permission_mode = "acceptEdits"
allowed_tools = [
  "Read", "Edit", "Write", "Grep", "Glob", "TodoWrite",
  "Bash(git add:*)", "Bash(git commit:*)", "Bash(git status:*)",
  "Bash(git diff:*)", "Bash(git log:*)", "Bash(git restore:*)",
  "Bash(ls:*)", "Bash(cat:*)", "Bash(rg:*)", "Bash(find:*)",
  "Bash(npm:*)", "Bash(npx:*)", "Bash(pnpm:*)", "Bash(yarn:*)",
  "Bash(python:*)", "Bash(python3:*)", "Bash(pytest:*)", "Bash(make:*)",
  "Bash(go:*)", "Bash(cargo:*)",
]
disallowed_tools = [
  "Bash(git push:*)", "Bash(git remote:*)", "Bash(git reset --hard:*)",
  "Bash(gh:*)", "Bash(rm -rf:*)", "Bash(sudo:*)",
]

[loop]
max_concurrent_agents = 3
max_iterations = 5            # review rounds before parking the task
max_open_prs = 5
issue_poll_sec = 60
skip_labels = ["no-agent", "wontfix", "blocked", "question"]
ci_timeout_sec = 1800         # a 5/5 PR must also pass CI; park if checks run longer than this
only_labels = ["agent"]       # work only issues carrying one of these; [] = every open issue

[greptile]
bot_logins = ["greptile-apps[bot]", "greptile[bot]", "greptile-apps-staging[bot]"]
poll_interval_sec = 20
review_timeout_sec = 1200
max_retriggers = 2
retrigger_body = "@greptileai review"
target_score = 5
fake_scores = []              # e.g. [3, 4, 5] to exercise the loop without Greptile

[safety]
dry_run = false
branch_prefix = "agent/issue-"
auto_merge = false            # intentionally off: a human merges
max_cost_per_issue_usd = 25.0
